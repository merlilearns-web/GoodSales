# Admin password for the "Haldus" panel (default: admin123 when unset)
ADMIN_PASSWORD=admin123

# Optional: secret used to sign the admin session cookie (defaults to a value derived from ADMIN_PASSWORD)
ADMIN_SECRET=

# Railway PostgreSQL connection string. Set automatically on Railway when the Postgres service is linked.
# Without it the app serves the bundled Excel file and uploads are kept only in server memory.
DATABASE_URL=

# Optional: file name in /public used as the default dataset (defaults to the first .xlsx file found there)
DEFAULT_DATASET_FILE=
